{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "nextjs",
  "installCommand": "printf '%s' '{\"name\":\"agentcrm-browser-demo-root\",\"private\":true,\"dependencies\":{\"next\":\"16.2.12\"}}' > package.json && cd ../.. && DATABASE_URL=postgresql://demo:demo@127.0.0.1:5432/demo bun install",
  "buildCommand": "cd ../../apps/app && NEXT_PUBLIC_DEMO_MODE=true DATABASE_URL=postgresql://demo:demo@127.0.0.1:5432/demo BETTER_AUTH_SECRET=demo-browser-only-secret-not-used-in-production bun run build",
  "outputDirectory": "../../apps/app/.next"
}
