{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "nextjs",
  "installCommand": "cd ../.. && DATABASE_URL=postgresql://demo:demo@127.0.0.1:5432/demo bun install",
  "buildCommand": "cd ../../apps/app && NEXT_PUBLIC_DEMO_MODE=true DATABASE_URL=postgresql://demo:demo@127.0.0.1:5432/demo BETTER_AUTH_SECRET=demo-browser-only-secret-not-used-in-production bun run build",
  "outputDirectory": "../../apps/app/.next"
}
